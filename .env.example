FOOTBALL_DATA_KEY=your_football_data_org_key_here
MATCH_CACHE_TTL_SECONDS=900

# Optional Vercel KV / Upstash REST storage for predictions and cached match data.
# KV_REST_API_URL=https://your-kv-url.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_token

# Optional Google Sheets / Apps Script append-only audit log.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=replace_with_a_random_shared_secret

# Optional secondary fallback provider:
# API_FOOTBALL_KEY=your_api_football_api_sports_key_here

# Force live match refresh in the browser:
# https://your-domain.vercel.app/api/matches?refresh=1
